<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL with or without <code>https://</code>. Your links stay in this browser.</p>
<p id="feedback" class="feedback" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    formatBookmark,
    generateUniqueSlug,
    normalizeUrl,
    parseBookmarks,
  } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const feedback = document.getElementById('feedback');
  const clearButton = document.getElementById('clear-all');
  let bookmarks = [];

  function setFeedback(message) {
    if (feedback) feedback.textContent = message;
  }

  function loadBookmarks() {
    try {
      return parseBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      setFeedback('Browser storage is unavailable. Bookmarks may not persist after you leave.');
      return [];
    }
  }

  function persistBookmarks() {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      return true;
    } catch {
      return false;
    }
  }

  function renderBookmarks() {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const label = document.createElement('span');
      label.className = 'bookmark-label';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      label.append(link, document.createTextNode(' :: '), slug);

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy slug';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setFeedback(`Copied ${bookmark.slug} to the clipboard.`);
        } catch {
          setFeedback('Could not access the clipboard. Select the slug to copy it.');
        }
      });

      item.append(label, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  bookmarks = loadBookmarks();
  renderBookmarks();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    /** @type {string} */
    let url;
    try {
      url = normalizeUrl(urlInput?.value ?? '');
    } catch {
      setFeedback('Enter a valid web URL, such as example.com.');
      urlInput?.focus();
      return;
    }

    const bookmark = { url, slug: generateUniqueSlug(bookmarks) };
    bookmarks.push(bookmark);
    renderBookmarks();
    form?.reset();

    if (persistBookmarks()) {
      setFeedback(`Saved ${formatBookmark(bookmark)}.`);
    } else {
      setFeedback('Added for this visit, but browser storage is unavailable.');
    }
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks from this browser?')) return;
    bookmarks = [];
    renderBookmarks();
    if (persistBookmarks()) {
      setFeedback('All bookmarks cleared.');
    } else {
      setFeedback('Cleared for this visit, but browser storage is unavailable.');
    }
  });
</script>
