---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light dark;
        --accent: #c75b37;
        --accent-soft: color-mix(in srgb, var(--accent) 12%, transparent);
        --border: color-mix(in srgb, currentColor 14%, transparent);
        --muted: color-mix(in srgb, currentColor 58%, transparent);
        --surface: color-mix(in srgb, Canvas 92%, var(--accent) 8%);
        --radius: 1rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        max-width: 48rem;
        min-height: 100vh;
        margin: 0 auto;
        padding: clamp(2.5rem, 8vw, 5rem) 1.25rem 4rem;
        background:
          radial-gradient(ellipse at 10% 0%, var(--accent-soft), transparent 34rem),
          Canvas;
      }
      header { margin-bottom: 2rem; }
      h1 { margin: 0 0 0.5rem; font-size: clamp(1.7rem, 5vw, 2.35rem); line-height: 1.2; font-family: var(--font-head); letter-spacing: -0.035em; }
      .tagline { max-width: 38rem; margin: 0; color: var(--muted); }
      code { color: color-mix(in srgb, var(--accent) 85%, currentColor); }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: end;
        margin: 1.5rem 0 0.6rem;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) + 0.2rem);
        background: var(--surface);
        box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 6%, transparent);
      }
      .field { display: flex; flex-direction: column; gap: 0.4rem; flex: 1 1 16rem; }
      label { font-size: 0.82rem; font-weight: 600; }
      input {
        min-height: 2.9rem;
        padding: 0.7rem 0.8rem;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        font: inherit;
        background: transparent;
        color: inherit;
      }
      input:focus-visible,
      button:focus-visible,
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      button {
        min-height: 2.9rem;
        padding: 0.65rem 1rem;
        border: 1px solid transparent;
        border-radius: 0.75rem;
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { filter: brightness(1.08); transform: translateY(-1px); }
      .hint { margin: 0 0 1.5rem; font-size: 0.8rem; color: var(--muted); }
      .feedback { min-height: 1.5em; margin: -1rem 0 1rem; color: var(--accent); font-size: 0.8rem; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 2rem 0 0.75rem;
      }
      #list-header[hidden] { display: none; }
      .list-title { margin: 0; font-size: 1.05rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        min-height: 2.3rem;
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: currentColor; }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.65rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.65rem 1rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        transition: border-color 150ms ease, transform 150ms ease;
      }
      li.bookmark:hover { border-color: color-mix(in srgb, var(--accent) 42%, var(--border)); transform: translateY(-1px); }
      .bookmark-label { flex: 1 1 15rem; overflow-wrap: anywhere; }
      .bookmark .url { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent); text-underline-offset: 0.2em; }
      .bookmark .slug {
        font-family: var(--font-head);
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
        border-radius: 0.45rem;
        background: var(--accent-soft);
        white-space: nowrap;
      }
      .bookmark .copy {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        min-height: 2.3rem;
        padding: 0.3rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 2rem 1.25rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed color-mix(in srgb, var(--accent) 35%, var(--border));
        border-radius: calc(var(--radius) + 0.2rem);
        background: var(--surface);
      }

      footer { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.8rem; color: var(--muted); }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
